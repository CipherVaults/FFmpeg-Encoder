{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 500000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
