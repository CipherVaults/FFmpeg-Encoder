name: Regular checkpoint 138 packaged live encoding accessibility and progress observation (report only)
on:
  push:
    branches: [blue/regular-win-r06-progress-138-once]
    paths: [.github/workflows/regular-windows-138-r06-progress.yml]
permissions:
  contents: read
concurrency:
  group: regular-windows-r06-progress-138-once
  cancel-in-progress: false
jobs:
  package:
    if: ${{ github.repository == 'CipherVaults/FFmpeg-Encoder' && github.repository_id == '1460111553' && github.ref == 'refs/heads/blue/regular-win-r06-progress-138-once' && github.event_name == 'push' && github.event.before == '__BOUND_SEED__' && github.event.after == github.sha && github.workflow_sha == github.sha && github.workflow_ref == 'CipherVaults/FFmpeg-Encoder/.github/workflows/regular-windows-138-r06-progress.yml@refs/heads/blue/regular-win-r06-progress-138-once' && github.event.created == false && github.event.forced == false && github.event.deleted == false && github.run_attempt == 1 }}
    runs-on: windows-2022
    timeout-minutes: 25
    env:
      GIT_CONFIG_COUNT: '1'
      GIT_CONFIG_KEY_0: core.autocrlf
      GIT_CONFIG_VALUE_0: 'false'
      GIT_LFS_SKIP_SMUDGE: '1'
      ELECTRON_SKIP_BINARY_DOWNLOAD: '1'
      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'
      npm_config_ignore_scripts: 'true'
      npm_config_audit: 'false'
      npm_config_fund: 'false'
    steps:
      - name: Check out reviewed harness event revision
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          path: harness
          ref: ${{ github.sha }}
          fetch-depth: 3
          persist-credentials: false
          lfs: false
          submodules: false
      - name: Check out exact independent checkpoint 138 product
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          path: product
          ref: 33196f7434d781e683bb35ed4445fd1db3cc118a
          fetch-depth: 1
          persist-credentials: false
          lfs: false
          submodules: false
      - name: Verify exact tracked inputs and fixed-volume capacity before downloads
        shell: pwsh
        run: node harness/.github/regular-windows-138-r06-progress/binding.cjs preflight
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: '24.22.1'
          package-manager-cache: false
      - name: Install only locked packaging metadata; lifecycle hooks disabled
        working-directory: product
        timeout-minutes: 5
        shell: pwsh
        run: |
          npm ci --ignore-scripts --no-audit --no-fund *> "$env:RUNNER_TEMP\regular-cp138-r06-progress-npm.log"
          if ($LASTEXITCODE -ne 0) { throw 'Locked dependency setup failed. No report or package retained.' }
      - name: Build and observe the bounded live encoding AX and steady progress journey
        id: verify
        timeout-minutes: 18
        shell: pwsh
        run: |
          $log = Join-Path $env:RUNNER_TEMP "regular-cp138-r06-progress-run.log"
          node harness/.github/regular-windows-138-r06-progress/binding.cjs run *> $log
          $status = $LASTEXITCODE
          $bound = @(Select-String -LiteralPath $log -Pattern "^Report SHA256 [a-f0-9]{64}$")
          if ($bound.Count -gt 1 -or ($status -eq 0 -and $bound.Count -ne 1)) { throw "Report digest unavailable or ambiguous." }
          if ($bound.Count -eq 1) { Write-Output $bound[0].Line }
          if ($status -ne 0) { throw 'Bounded run failed. Only the sanitized report is eligible for retention.' }
      - name: Retain the single sanitized report only
        if: ${{ !cancelled() && always() && steps.verify.outputs.report_ready == 'true' }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: regular-cp138-r06-progress-report-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ steps.verify.outputs.report_path }}
          if-no-files-found: error
          retention-days: 3
          compression-level: 0
